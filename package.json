{
  "name": "kookaburra-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-project.mjs && node scripts/verify-international.mjs",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run verify && npm run typecheck && npm run lint && npm run build",
    "test:e2e:visual": "playwright test --headed --project=chromium --workers=1",
    "test:e2e": "playwright test --project=chromium --workers=1",
    "test:e2e:list": "playwright test --list",
    "test:e2e:report": "playwright show-report",
    "verify:e2e": "node scripts/verify-e2e.mjs",
    "verify:usd-e2e": "node scripts/verify-usd-e2e.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.2",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.64.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
